{
    "name": "webcloster/deployer",
    "description": "Self-hosted, daemon-less deployer for cPanel hosting, shipped as a single phar.",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "ext-pdo_sqlite": "*",
        "symfony/polyfill-mbstring": "^1.31",
        "symfony/process": "^7.3",
        "symfony/yaml": "^7.3"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "symfony/var-dumper": "^7.3"
    },
    "autoload": {
        "psr-4": {
            "Deployer\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Deployer\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.2.0"
        },
        "sort-packages": true,
        "optimize-autoloader": true
    },
    "minimum-stability": "stable",
    "scripts": {
        "test": "phpunit",
        "build": [
            "Composer\\Config::disableProcessTimeout",
            "bash build/build.sh"
        ]
    }
}
